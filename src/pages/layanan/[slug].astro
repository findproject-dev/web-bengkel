---
import Layout from '../../layouts/Layout.astro';
import { SERVICES, getServiceBySlug } from '../../data/services';
import { SITE, waLink } from '../../config/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect('/layanan');
}

// Fetch related services
const relatedServices = service.relatedSlugs
  ? service.relatedSlugs.map((s) => getServiceBySlug(s)).filter(Boolean)
  : [];

// Standard service FAQs if not provided in service data
const defaultFaqs = [
  {
    q: `Berapa lama estimasi pengerjaan ${service.name}?`,
    a: `Pengerjaan umumnya memerlukan waktu sekitar ${service.duration}. Durasi sebenarnya dapat bervariasi tergantung kondisi aktual kendaraan dan antrean bengkel.`,
  },
  {
    q: `Apakah harga ${service.name} sudah final?`,
    a: `Harga yang tercantum (${service.startingPrice}) merupakan estimasi awal. Sebelum dilakukan pengerjaan, teknisi FindFix akan melakukan pemeriksaan menyeluruh dan mengonfirmasi rincian biaya kepada Anda. Tidak ada biaya tersembunyi tanpa persetujuan.`,
  },
  {
    q: `Apakah ada garansi untuk pengerjaan ini?`,
    a: `Ya, seluruh pengerjaan perbaikan dan servis di FindFix disertai garansi layanan sesuai dengan ketentuan dan jenis pengerjaan yang dilakukan.`,
  },
];

const faqs = service.faqs && service.faqs.length > 0 ? service.faqs : defaultFaqs;
---

<Layout
  title={`${service.name} - Layanan FindFix Semarang`}
  description={`${service.shortDesc} Dapatkan layanan ${service.name} profesional di Bengkel FindFix Semarang dengan harga transparan dan pengerjaan terpercaya.`}
  image={service.image}
>
  <!-- Service Hero -->
  <section class="service-detail-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/layanan">Layanan</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">{service.name}</span>
      </nav>

      <div class="service-hero-grid">
        <div class="service-hero-content">
          <div class="service-category-tag">
            {service.category === 'mobil' ? '🚗 Layanan Mobil' : service.category === 'motor' ? '🏍️ Layanan Motor' : '🔍 Layanan Umum'}
          </div>
          <h1 class="service-title">{service.name}</h1>
          <p class="service-short-desc">{service.shortDesc}</p>

          <div class="service-quick-meta">
            <div class="quick-meta-item">
              <span class="quick-meta-label">Estimasi Harga</span>
              <span class="quick-meta-value highlight">{service.startingPrice}</span>
            </div>
            <div class="quick-meta-divider" aria-hidden="true"></div>
            <div class="quick-meta-item">
              <span class="quick-meta-label">Estimasi Waktu</span>
              <span class="quick-meta-value">{service.duration}</span>
            </div>
            <div class="quick-meta-divider" aria-hidden="true"></div>
            <div class="quick-meta-item">
              <span class="quick-meta-label">Garansi</span>
              <span class="quick-meta-value">Tersedia Sesuai Ketentuan</span>
            </div>
          </div>

          <div class="service-hero-actions">
            <a href={`/booking?layanan=${encodeURIComponent(service.name)}`} class="btn btn-primary btn-lg">
              Booking Layanan Ini
            </a>
            <a
              href={waLink(`Halo FindFix! Saya ingin menanyakan layanan ${service.name}. Bisa berikan informasi lebih lanjut?`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline-white btn-lg"
            >
              Konsultasi WhatsApp
            </a>
          </div>
        </div>

        <div class="service-hero-media">
          <img src={service.image} alt={service.name} class="service-hero-img" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Detail Main Content -->
  <section class="section service-body-section">
    <div class="container service-layout-grid">
      <!-- Main Content Column -->
      <div class="service-main-content">
        <!-- Overview -->
        <article class="content-block">
          <h2 class="content-block-title">Deskripsi Layanan</h2>
          <p class="service-full-text">{service.description}</p>

          <div class="pricing-notice-box">
            <div class="notice-icon" aria-hidden="true">ℹ️</div>
            <div class="notice-text">
              <strong>Catatan Biaya:</strong> {service.priceNote || SITE.pricingDisclaimer}
            </div>
          </div>
        </article>

        <!-- Symptoms / Indications -->
        {service.symptoms && service.symptoms.length > 0 && (
          <article class="content-block">
            <h2 class="content-block-title">Kapan Kendaraan Membutuhkan Layanan Ini?</h2>
            <p class="content-block-lead">Perhatikan gejala dan indikasi berikut pada kendaraan Anda:</p>
            <div class="symptom-grid">
              {service.symptoms.map((symptom) => (
                <div class="symptom-item">
                  <span class="symptom-bullet" aria-hidden="true">⚠️</span>
                  <span>{symptom}</span>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- Benefits -->
        {service.benefits && service.benefits.length > 0 && (
          <article class="content-block">
            <h2 class="content-block-title">Keunggulan & Manfaat</h2>
            <div class="benefit-cards-grid">
              {service.benefits.map((benefit) => (
                <div class="benefit-card">
                  <div class="benefit-icon" aria-hidden="true">✓</div>
                  <div class="benefit-text">{benefit}</div>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- What is included -->
        {service.includes && service.includes.length > 0 && (
          <article class="content-block">
            <h2 class="content-block-title">Cakupan Pengerjaan</h2>
            <p class="content-block-lead">Item pemeriksaan dan pengerjaan yang termasuk dalam layanan:</p>
            <ul class="includes-list">
              {service.includes.map((item) => (
                <li class="includes-item">
                  <span class="includes-check" aria-hidden="true">✔</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        )}

        <!-- Procedure / Steps -->
        {service.procedure && service.procedure.length > 0 && (
          <article class="content-block">
            <h2 class="content-block-title">Prosedur & Alur Pengerjaan</h2>
            <div class="procedure-timeline">
              {service.procedure.map((step, idx) => (
                <div class="procedure-step">
                  <div class="procedure-num">{String(idx + 1).padStart(2, '0')}</div>
                  <div class="procedure-body">
                    <p class="procedure-desc">{step}</p>
                  </div>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- FAQ for this service -->
        <article class="content-block">
          <h2 class="content-block-title">Pertanyaan Seputar Layanan</h2>
          <div class="faq-list">
            {faqs.map((faq, i) => (
              <div class="accordion-item">
                <button
                  class="accordion-trigger"
                  aria-expanded="false"
                  aria-controls={`svc-faq-${i}`}
                  id={`svc-faq-btn-${i}`}
                >
                  <span>{faq.q}</span>
                  <span class="accordion-icon" aria-hidden="true">+</span>
                </button>
                <div
                  class="accordion-content"
                  id={`svc-faq-${i}`}
                  role="region"
                  aria-labelledby={`svc-faq-btn-${i}`}
                >
                  <div class="accordion-content-inner">{faq.a}</div>
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>

      <!-- Sidebar -->
      <aside class="service-sidebar">
        <!-- Quick Booking Card -->
        <div class="sidebar-card booking-widget">
          <h3 class="widget-title">Jadwalkan Servis</h3>
          <p class="widget-subtitle">Pesan jadwal kunjungan tanpa antre lama di bengkel.</p>
          <div class="widget-price">
            <span class="widget-price-label">Mulai Dari</span>
            <span class="widget-price-amount">{service.startingPrice}</span>
          </div>
          <a href={`/booking?layanan=${encodeURIComponent(service.name)}`} class="btn btn-primary btn-block">
            Booking Online
          </a>
          <a
            href={waLink(`Halo FindFix, saya ingin booking layanan ${service.name}. Mohon info slot jadwal terdekat.`)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-block"
            style="margin-top: 10px;"
          >
            Chat WhatsApp
          </a>
          <div class="widget-security">
            <span>🛡️ Konfirmasi cepat &amp; garansi pengerjaan</span>
          </div>
        </div>

        <!-- Workshop Hours Card -->
        <div class="sidebar-card">
          <h4 class="sidebar-subtitle">Jam Buka Bengkel</h4>
          <div class="sidebar-hours-list">
            <div class="hours-row-side">
              <span>Senin – Jumat</span>
              <strong>08.00 – 17.00</strong>
            </div>
            <div class="hours-row-side">
              <span>Sabtu</span>
              <strong>08.00 – 15.00</strong>
            </div>
            <div class="hours-row-side closed">
              <span>Minggu</span>
              <strong>Tutup</strong>
            </div>
          </div>
          <p class="sidebar-location-tip">
            📍 Lokasi: {SITE.city}, {SITE.province}
          </p>
        </div>

        <!-- Related Services -->
        {relatedServices.length > 0 && (
          <div class="sidebar-card">
            <h4 class="sidebar-subtitle">Layanan Terkait</h4>
            <div class="related-services-list">
              {relatedServices.map((rel) => (
                <a href={`/layanan/${rel.slug}`} class="related-service-item">
                  <div class="related-img-wrap">
                    <img src={rel.image} alt={rel.name} class="related-img" loading="lazy" />
                  </div>
                  <div class="related-info">
                    <span class="related-name">{rel.name}</span>
                    <span class="related-price">{rel.startingPrice}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section-dark service-bottom-cta">
    <div class="container" style="text-align: center;">
      <p class="section-eyebrow" style="color: var(--color-orange); margin: 0 auto 16px;">Solusi Tepat Kendaraan Anda</p>
      <h2 style="max-width: 20ch; margin: 0 auto 16px;">Siap Mengembalikan Performa Kendaraan Anda?</h2>
      <p class="section-desc" style="margin: 0 auto 32px; color: rgba(255,255,255,0.7);">
        Pesan jadwal servis Anda sekarang atau hubungi tim FindFix untuk konsultasi awal gratis melalui WhatsApp.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href={`/booking?layanan=${encodeURIComponent(service.name)}`} class="btn btn-primary btn-lg">
          Booking {service.name}
        </a>
        <a href="/layanan" class="btn btn-outline-white btn-lg">
          Lihat Semua Layanan
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
.service-detail-hero {
  background: var(--color-navy);
  color: white;
  padding: 120px 0 64px;
}
.service-hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
  align-items: center;
  margin-top: 24px;
}
.service-category-tag {
  display: inline-block;
  background: rgba(244, 123, 53, 0.15);
  border: 1px solid rgba(244, 123, 53, 0.35);
  color: var(--color-orange);
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 6px 14px;
  border-radius: 999px;
  margin-bottom: 16px;
}
.service-title {
  color: white;
  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1.15;
  margin-bottom: 16px;
}
.service-short-desc {
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  margin-bottom: 28px;
}
.service-quick-meta {
  display: flex;
  align-items: center;
  gap: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.quick-meta-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quick-meta-label {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.quick-meta-value {
  font-family: var(--font-heading);
  font-size: 1.125rem;
  font-weight: 700;
  color: white;
}
.quick-meta-value.highlight {
  color: var(--color-orange);
}
.quick-meta-divider {
  width: 1px;
  height: 36px;
  background: rgba(255, 255, 255, 0.12);
}
.service-hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}
.service-hero-media {
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
}
.service-hero-img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  display: block;
}

/* Service Main Grid */
.service-layout-grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 48px;
  align-items: start;
}
.service-main-content {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.content-block {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 36px;
}
.content-block-title {
  font-size: 1.5rem;
  color: var(--color-navy);
  margin-bottom: 16px;
  position: relative;
  padding-bottom: 12px;
}
.content-block-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 40px;
  height: 3px;
  background: var(--color-orange);
  border-radius: 2px;
}
.content-block-lead {
  font-size: 0.95rem;
  color: var(--color-gray);
  margin-bottom: 20px;
}
.service-full-text {
  font-size: 1.0625rem;
  line-height: 1.75;
  color: var(--color-slate);
  margin-bottom: 24px;
}
.pricing-notice-box {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  background: rgba(244, 123, 53, 0.08);
  border: 1px solid rgba(244, 123, 53, 0.25);
  border-radius: var(--radius-md);
  padding: 16px;
  font-size: 0.875rem;
  color: var(--color-navy);
  line-height: 1.5;
}
.notice-icon {
  font-size: 1.25rem;
  flex-shrink: 0;
}

/* Symptoms Grid */
.symptom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.symptom-item {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 14px 16px;
  background: var(--color-off-white);
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  color: var(--color-navy);
  font-weight: 500;
}
.symptom-bullet {
  font-size: 1rem;
  flex-shrink: 0;
}

/* Benefit Cards */
.benefit-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.benefit-card {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-off-white);
}
.benefit-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-orange);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.875rem;
  font-weight: 700;
  flex-shrink: 0;
}
.benefit-text {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-navy);
}

/* Includes List */
.includes-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.includes-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  background: var(--color-off-white);
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  color: var(--color-navy);
}
.includes-check {
  color: #10B981;
  font-weight: bold;
}

/* Procedure Timeline */
.procedure-timeline {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.procedure-step {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  padding: 18px 20px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-off-white);
}
.procedure-num {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--color-orange);
  background: rgba(244, 123, 53, 0.12);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.procedure-body {
  padding-top: 8px;
}
.procedure-desc {
  font-size: 0.95rem;
  color: var(--color-slate);
  line-height: 1.5;
  margin: 0;
}

/* Sidebar */
.service-sidebar {
  display: flex;
  flex-direction: column;
  gap: 24px;
  position: sticky;
  top: 100px;
}
.sidebar-card {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 28px;
}
.booking-widget {
  border-top: 4px solid var(--color-orange);
}
.widget-title {
  font-size: 1.25rem;
  color: var(--color-navy);
  margin-bottom: 6px;
}
.widget-subtitle {
  font-size: 0.8125rem;
  color: var(--color-gray);
  margin-bottom: 20px;
  line-height: 1.4;
}
.widget-price {
  background: var(--color-off-white);
  padding: 16px;
  border-radius: var(--radius-md);
  text-align: center;
  margin-bottom: 20px;
}
.widget-price-label {
  display: block;
  font-size: 0.75rem;
  color: var(--color-gray);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}
.widget-price-amount {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-orange);
}
.btn-block {
  width: 100%;
  justify-content: center;
}
.widget-security {
  font-size: 0.75rem;
  color: var(--color-gray);
  text-align: center;
  margin-top: 14px;
}

/* Hours */
.sidebar-subtitle {
  font-size: 1rem;
  color: var(--color-navy);
  margin-bottom: 14px;
  font-weight: 700;
}
.sidebar-hours-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 14px;
}
.hours-row-side {
  display: flex;
  justify-content: space-between;
  font-size: 0.8125rem;
  color: var(--color-slate);
  padding: 6px 0;
  border-bottom: 1px solid var(--color-border);
}
.hours-row-side.closed {
  color: var(--color-gray);
}
.sidebar-location-tip {
  font-size: 0.8125rem;
  color: var(--color-gray);
  margin-top: 8px;
}

/* Related Services */
.related-services-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.related-service-item {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 8px;
  border-radius: var(--radius-sm);
  transition: background var(--transition-fast);
}
.related-service-item:hover {
  background: var(--color-off-white);
}
.related-img-wrap {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}
.related-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.related-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.related-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.3;
}
.related-price {
  font-size: 0.75rem;
  color: var(--color-orange);
  font-weight: 700;
}

@media (max-width: 1024px) {
  .service-hero-grid {
    grid-template-columns: 1fr;
  }
  .service-layout-grid {
    grid-template-columns: 1fr;
  }
  .service-sidebar {
    position: static;
  }
}

@media (max-width: 768px) {
  .symptom-grid,
  .benefit-cards-grid,
  .includes-list {
    grid-template-columns: 1fr;
  }
  .content-block {
    padding: 24px;
  }
}
</style>
