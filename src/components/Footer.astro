---
import { SITE, waLink } from '../config/site';

const currentYear = new Date().getFullYear();

const footerLinks = {
  navigasi: [
    { label: 'Beranda', href: '/' },
    { label: 'Tentang Kami', href: '/tentang-kami' },
    { label: 'Layanan', href: '/layanan' },
    { label: 'Harga', href: '/harga' },
    { label: 'Promo', href: '/promo' },
    { label: 'Galeri', href: '/galeri' },
    { label: 'Artikel', href: '/artikel' },
    { label: 'Kontak', href: '/kontak' },
  ],
  layanan: [
    { label: 'Servis Berkala Mobil', href: '/layanan/servis-berkala-mobil' },
    { label: 'Tune Up Mobil', href: '/layanan/tune-up-mobil' },
    { label: 'Ganti Oli', href: '/layanan/ganti-oli-mobil' },
    { label: 'Servis AC', href: '/layanan/servis-ac-mobil' },
    { label: 'Rem & Kaki-kaki', href: '/layanan/perbaikan-rem-mobil' },
    { label: 'Servis Motor', href: '/layanan/servis-ringan-motor' },
    { label: 'Servis CVT', href: '/layanan/servis-cvt-motor' },
    { label: 'Spare Part', href: '/spare-part' },
  ],
  legal: [
    { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
    { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  ],
};
---

<footer class="footer">
  <!-- Main Footer -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label="FindFix">
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="36" height="36" rx="8" fill="#F47B35"/>
              <path d="M8 14h20M8 18h14M8 22h18" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="26" cy="22" r="3" stroke="white" stroke-width="2"/>
              <path d="M24.5 20.5L27.5 23.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="footer-logo-text">
              <span style="color:white">Find</span><span style="color:var(--color-orange)">Fix</span>
            </span>
          </a>
          <p class="footer-desc">
            Bengkel umum mobil dan motor di Semarang. Perawatan dan perbaikan kendaraan dengan harga kompetitif, pengerjaan profesional, dan pelayanan terpercaya sejak 2017.
          </p>
          <p class="footer-tagline">"{SITE.tagline}"</p>

          <!-- Contact Info -->
          <div class="footer-contact">
            <div class="footer-contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{SITE.address}, {SITE.city}</span>
            </div>
            <a href={`tel:${SITE.phone}`} class="footer-contact-item footer-contact-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.09-1.09a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 16l.19.92z"/>
              </svg>
              <span>{SITE.whatsappDisplay}</span>
            </a>
            <a href={`mailto:${SITE.email}`} class="footer-contact-item footer-contact-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <span>{SITE.email}</span>
            </a>
          </div>

          <!-- Social -->
          <div class="footer-social">
            {SITE.social.instagram && (
              <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram FindFix">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </a>
            )}
            {SITE.social.facebook && (
              <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook FindFix">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            )}
            {SITE.social.tiktok && (
              <a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="TikTok FindFix">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </a>
            )}
            <a href={waLink("Halo FindFix! Saya ingin menghubungi tim FindFix.")} target="_blank" rel="noopener noreferrer" class="social-link social-wa" aria-label="WhatsApp FindFix">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Navigation Links -->
        <div class="footer-col">
          <h4 class="footer-col-title">Navigasi</h4>
          <ul>
            {footerLinks.navigasi.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Services Links -->
        <div class="footer-col">
          <h4 class="footer-col-title">Layanan</h4>
          <ul>
            {footerLinks.layanan.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Hours & Info -->
        <div class="footer-col">
          <h4 class="footer-col-title">Jam Operasional</h4>
          <div class="footer-hours">
            <div class="hours-row">
              <span>Senin – Jumat</span>
              <span>08.00 – 17.00</span>
            </div>
            <div class="hours-row">
              <span>Sabtu</span>
              <span>08.00 – 15.00</span>
            </div>
            <div class="hours-row hours-closed">
              <span>Minggu</span>
              <span>Tutup</span>
            </div>
          </div>
          <p class="footer-hours-note">Jam dapat berubah pada hari libur nasional.</p>

          <div style="margin-top: 24px;">
            <h4 class="footer-col-title">Booking Servis</h4>
            <p style="font-size: 0.875rem; color: rgba(255,255,255,0.5); margin-bottom: 12px;">Pesan jadwal servis dengan mudah</p>
            <a href="/booking" class="btn btn-primary btn-sm">
              Booking Sekarang
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        © {currentYear} {SITE.fullName}. Hak cipta dilindungi.
      </p>
      <div class="footer-legal">
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="footer-legal-link">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy);
    color: rgba(255,255,255,0.65);
  }
  .footer-main {
    padding: 72px 0 56px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.3fr;
    gap: 48px;
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 20px;
  }
  .footer-logo-text {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    margin-bottom: 12px;
    max-width: 36ch;
  }
  .footer-tagline {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    color: var(--color-orange);
    font-style: italic;
    margin-bottom: 24px;
  }

  /* Contact */
  .footer-contact { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
  }
  .footer-contact-item svg { flex-shrink: 0; margin-top: 2px; }
  .footer-contact-link { transition: color var(--transition-fast); }
  .footer-contact-link:hover { color: var(--color-orange); }

  /* Social */
  .footer-social { display: flex; gap: 10px; }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.6);
    transition: all var(--transition-fast);
  }
  .social-link:hover { background: var(--color-orange); color: white; transform: translateY(-2px); }
  .social-wa:hover { background: #25D366; }

  /* Col */
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 20px;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 8px; }
  .footer-link {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.55);
    transition: color var(--transition-fast);
    display: inline-block;
  }
  .footer-link:hover { color: white; }

  /* Hours */
  .footer-hours { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.65);
    padding: 8px 12px;
    background: rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
  }
  .hours-closed { color: rgba(255,255,255,0.3); }
  .hours-row span:last-child { font-weight: 500; color: rgba(255,255,255,0.8); }
  .hours-closed span:last-child { color: rgba(255,255,255,0.3); }
  .footer-hours-note { font-size: 0.75rem; color: rgba(255,255,255,0.3); }

  /* Bottom */
  .footer-bottom { padding: 20px 0; }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-copyright { font-size: 0.8125rem; color: rgba(255,255,255,0.3); }
  .footer-legal { display: flex; gap: 20px; }
  .footer-legal-link { font-size: 0.8125rem; color: rgba(255,255,255,0.3); transition: color var(--transition-fast); }
  .footer-legal-link:hover { color: rgba(255,255,255,0.7); }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-desc { max-width: 60ch; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
