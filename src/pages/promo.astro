---
import Layout from '../layouts/Layout.astro';
import { PROMOS } from '../data/promos';
import { SITE, waLink } from '../config/site';

const featuredPromo = PROMOS.find((p) => p.id === 'paket-servis-hemat-motor') || PROMOS[0];
const otherPromos = PROMOS.filter((p) => p.id !== featuredPromo.id);
---

<Layout
  title="Promo & Paket Servis Hemat - FindFix Semarang"
  description="Penawaran paket servis hemat dan promo perawatan kendaraan di FindFix Semarang. Diskon ganti oli, paket servis berkala, dan promo pemeriksaan pra-perjalanan."
>
  <!-- Hero Section -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Promo &amp; Paket</span>
      </nav>

      <div class="promo-hero-header">
        <p class="section-eyebrow">Penawaran Spesial</p>
        <h1>Paket Servis Hemat &amp; Promo Kendaraan</h1>
        <p class="hero-desc">
          Nikmati berbagai paket kombinasi servis dan penawaran hemat untuk menjaga performa mobil dan motor Anda tetap prima dengan pengeluaran yang lebih efisien.
        </p>

        <!-- Informational Banner -->
        <div class="promo-page-notice">
          <span class="notice-badge">Catatan Promo</span>
          <p class="notice-text">
            {SITE.promotionsNote} Penawaran dapat berubah sewaktu-waktu. Silakan hubungi bengkel FindFix melalui WhatsApp untuk konfirmasi penawaran yang aktif hari ini.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Promotion Spotlight -->
  <section class="section featured-promo-section">
    <div class="container">
      <div class="section-header" style="text-align: center; margin-bottom: 40px;">
        <p class="section-eyebrow" style="margin: 0 auto 12px;">Sorotan Utama</p>
        <h2 class="section-title">Paket Paling Diminati Bulan Ini</h2>
      </div>

      <div class="featured-promo-banner">
        <div class="featured-promo-grid">
          <div class="featured-promo-img-wrap">
            <img src={featuredPromo.image} alt={featuredPromo.title} class="featured-promo-img" loading="eager" />
            {featuredPromo.badge && <span class="featured-badge">{featuredPromo.badge}</span>}
          </div>

          <div class="featured-promo-info">
            <span class="promo-category-tag">Paket Kombinasi Servis</span>
            <h3 class="featured-promo-title">{featuredPromo.title}</h3>
            <p class="featured-promo-sub">{featuredPromo.subtitle}</p>
            <p class="featured-promo-desc">{featuredPromo.description}</p>

            <div class="featured-includes">
              <span class="includes-title">Apa yang Anda Dapatkan:</span>
              <ul class="includes-bullets">
                {featuredPromo.items.map((it) => (
                  <li>
                    <span class="bullet-check">✔</span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="featured-price-box">
              <div class="price-wrap">
                {featuredPromo.originalPrice && (
                  <span class="orig-price">{featuredPromo.originalPrice}</span>
                )}
                <span class="deal-price">{featuredPromo.promoPrice}</span>
              </div>
              <a
                href={waLink(`Halo FindFix, saya ingin klaim penawaran "${featuredPromo.title}". Apakah masih tersedia untuk jadwal besok/minggu ini?`)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-lg"
              >
                Ambil Promo via WhatsApp
              </a>
            </div>

            <div class="promo-terms-preview">
              <strong>Syarat &amp; Ketentuan:</strong>
              <ul>
                {featuredPromo.terms.map((t) => (
                  <li>• {t}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Promotions Grid -->
  <section class="section section-offwhite other-promos-section">
    <div class="container">
      <div class="section-header" style="text-align: center; margin-bottom: 48px;">
        <p class="section-eyebrow" style="margin: 0 auto 12px;">Pilihan Lainnya</p>
        <h2 class="section-title">Semua Paket &amp; Promo FindFix</h2>
        <p class="section-desc" style="margin: 0 auto;">Pilih paket perawatan yang paling sesuai dengan kebutuhan kendaraan Anda.</p>
      </div>

      <div class="promos-cards-grid">
        {otherPromos.map((promo) => (
          <div class="promo-card-full">
            <div class="promo-card-media">
              <img src={promo.image} alt={promo.title} class="promo-card-img" loading="lazy" />
              {promo.badge && <span class="promo-card-badge">{promo.badge}</span>}
            </div>

            <div class="promo-card-content">
              <span class="promo-type-label">
                {promo.category === 'paket' ? 'Paket Servis' : 'Promo Khusus'}
              </span>
              <h3 class="promo-card-title">{promo.title}</h3>
              <p class="promo-card-sub">{promo.subtitle}</p>
              <p class="promo-card-desc">{promo.description}</p>

              <div class="promo-card-items">
                <span class="card-items-label">Termasuk:</span>
                <ul class="card-items-list">
                  {promo.items.map((item) => (
                    <li>
                      <span class="check-small">✔</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="promo-card-pricing">
                {promo.originalPrice && <span class="card-orig-price">{promo.originalPrice}</span>}
                <span class="card-promo-price">{promo.promoPrice}</span>
              </div>

              <div class="promo-card-terms">
                <details class="terms-details">
                  <summary class="terms-summary">Lihat Syarat &amp; Ketentuan</summary>
                  <ul class="terms-list">
                    {promo.terms.map((term) => (
                      <li>{term}</li>
                    ))}
                  </ul>
                </details>
              </div>

              <div class="promo-card-action">
                <a
                  href={waLink(`Halo FindFix, saya tertarik dengan penawaran "${promo.title}". Mohon informasi apakah promo ini masih aktif?`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-block"
                >
                  Tanya Promo Ini via WhatsApp
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How to Claim Section -->
  <section class="section claim-steps-section">
    <div class="container">
      <div class="section-header" style="text-align: center; margin-bottom: 48px;">
        <p class="section-eyebrow" style="margin: 0 auto 12px;">Alur Mudah</p>
        <h2 class="section-title">Cara Klaim Promo Servis</h2>
      </div>

      <div class="claim-steps-grid">
        <div class="claim-step">
          <div class="step-circle">1</div>
          <h3 class="claim-title">Pilih Promo</h3>
          <p class="claim-desc">Tentukan penawaran atau paket servis yang sesuai dengan tipe kendaraan Anda.</p>
        </div>

        <div class="claim-step">
          <div class="step-circle">2</div>
          <h3 class="claim-title">Hubungi WhatsApp</h3>
          <p class="claim-desc">Klik tombol promo untuk mengirim pesan ke admin FindFix dan mengonfirmasi ketersediaan slot.</p>
        </div>

        <div class="claim-step">
          <div class="step-circle">3</div>
          <h3 class="claim-title">Tentukan Jadwal</h3>
          <p class="claim-desc">Sepakati tanggal dan jam kedatangan ke bengkel agar teknisi siap menyambut Anda.</p>
        </div>

        <div class="claim-step">
          <div class="step-circle">4</div>
          <h3 class="claim-title">Datang &amp; Servis</h3>
          <p class="claim-desc">Kunjungi bengkel FindFix dan tunjukkan pesan konfirmasi promo saat penerimaan kendaraan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section-dark final-cta">
    <div class="container" style="text-align: center;">
      <p class="section-eyebrow" style="color: var(--color-orange); margin: 0 auto 16px;">Kebutuhan Khusus?</p>
      <h2 style="max-width: 18ch; margin: 0 auto 20px;">Punya Kebutuhan Servis dalam Jumlah Banyak?</h2>
      <p class="section-desc" style="margin: 0 auto 36px; color: rgba(255,255,255,0.65);">
        FindFix juga melayani perawatan armada kendaraan operasional (fleet) kantor atau keluarga dengan skema penawaran menarik. Hubungi kami untuk diskusi lebih lanjut.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/booking" class="btn btn-primary btn-lg">Booking Servis Biasa</a>
        <a
          href={waLink("Halo FindFix, saya ingin menanyakan kerja sama perawatan armada/kendaraan berkala. Bisa dibantu?")}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-white btn-lg"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
.promo-hero-header {
  max-width: 760px;
  margin-top: 24px;
}
.promo-hero-header h1 {
  color: white;
  margin-bottom: 16px;
}
.promo-page-notice {
  margin-top: 28px;
  background: rgba(244, 123, 53, 0.1);
  border: 1px solid rgba(244, 123, 53, 0.3);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.notice-badge {
  background: var(--color-orange);
  color: white;
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.notice-text {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  margin: 0;
}

/* Featured Spotlight */
.featured-promo-banner {
  background: var(--color-white);
  border: 2px solid var(--color-orange);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.featured-promo-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
}
.featured-promo-img-wrap {
  position: relative;
}
.featured-promo-img {
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: cover;
  display: block;
}
.featured-badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: var(--color-orange);
  color: white;
  font-family: var(--font-heading);
  font-size: 0.8125rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 6px 14px;
  border-radius: 999px;
  box-shadow: var(--shadow-orange);
}
.featured-promo-info {
  padding: 40px;
  display: flex;
  flex-direction: column;
}
.promo-category-tag {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-orange);
  margin-bottom: 8px;
}
.featured-promo-title {
  font-size: 1.75rem;
  color: var(--color-navy);
  margin-bottom: 6px;
}
.featured-promo-sub {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-slate);
  margin-bottom: 12px;
}
.featured-promo-desc {
  font-size: 0.9375rem;
  color: var(--color-gray);
  line-height: 1.6;
  margin-bottom: 24px;
}

.featured-includes {
  background: var(--color-off-white);
  padding: 20px;
  border-radius: var(--radius-md);
  margin-bottom: 24px;
}
.includes-title {
  display: block;
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--color-navy);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
}
.includes-bullets {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.includes-bullets li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
  color: var(--color-slate);
}
.bullet-check {
  color: var(--color-orange);
  font-weight: bold;
}

.featured-price-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.orig-price {
  font-size: 1.125rem;
  color: var(--color-gray);
  text-decoration: line-through;
}
.deal-price {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 800;
  color: var(--color-orange);
}

.promo-terms-preview {
  font-size: 0.8125rem;
  color: var(--color-gray);
  line-height: 1.5;
  border-top: 1px solid var(--color-border);
  padding-top: 16px;
}
.promo-terms-preview strong {
  display: block;
  color: var(--color-slate);
  margin-bottom: 4px;
}

/* Other Promos Grid */
.promos-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.promo-card-full {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-base);
}
.promo-card-full:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
  border-color: rgba(244, 123, 53, 0.4);
}
.promo-card-media {
  position: relative;
}
.promo-card-img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}
.promo-card-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--color-orange);
  color: white;
  font-size: 0.6875rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
  letter-spacing: 0.06em;
}
.promo-card-content {
  padding: 28px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.promo-type-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-orange);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 6px;
}
.promo-card-title {
  font-size: 1.25rem;
  color: var(--color-navy);
  margin-bottom: 4px;
}
.promo-card-sub {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-slate);
  margin-bottom: 10px;
}
.promo-card-desc {
  font-size: 0.8125rem;
  color: var(--color-gray);
  line-height: 1.55;
  margin-bottom: 18px;
}

.promo-card-items {
  background: var(--color-off-white);
  padding: 14px 16px;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  flex: 1;
}
.card-items-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-navy);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}
.card-items-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.card-items-list li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  color: var(--color-slate);
}
.check-small {
  color: var(--color-orange);
  font-weight: bold;
}

.promo-card-pricing {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 16px;
}
.card-orig-price {
  font-size: 0.875rem;
  color: var(--color-gray);
  text-decoration: line-through;
}
.card-promo-price {
  font-family: var(--font-heading);
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--color-orange);
}

.promo-card-terms {
  margin-bottom: 20px;
}
.terms-summary {
  font-size: 0.75rem;
  color: var(--color-gray);
  cursor: pointer;
  user-select: none;
}
.terms-summary:hover {
  color: var(--color-orange);
}
.terms-list {
  font-size: 0.75rem;
  color: var(--color-gray);
  margin-top: 6px;
  padding-left: 14px;
  line-height: 1.4;
}
.btn-block {
  width: 100%;
  justify-content: center;
}

/* Claim Steps */
.claim-steps-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.claim-step {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-circle {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--color-navy);
  color: var(--color-orange);
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.claim-title {
  font-size: 1.0625rem;
  color: var(--color-navy);
  margin-bottom: 8px;
}
.claim-desc {
  font-size: 0.8125rem;
  color: var(--color-gray);
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 1024px) {
  .featured-promo-grid {
    grid-template-columns: 1fr;
  }
  .featured-promo-img {
    height: 300px;
    min-height: auto;
  }
  .promos-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .claim-steps-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .promos-cards-grid,
  .claim-steps-grid {
    grid-template-columns: 1fr;
  }
  .featured-promo-info {
    padding: 24px;
  }
  .includes-bullets {
    grid-template-columns: 1fr;
  }
}
</style>
