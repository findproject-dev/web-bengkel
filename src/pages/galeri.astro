---
import Layout from '../layouts/Layout.astro';
import { SITE, waLink } from '../config/site';

const galleryCategories = [
  { id: 'all', label: 'Semua Foto' },
  { id: 'interior', label: 'Interior Bengkel' },
  { id: 'exterior', label: 'Eksterior & Fasilitas' },
  { id: 'mobil', label: 'Perawatan Mobil' },
  { id: 'motor', label: 'Perawatan Motor' },
  { id: 'proses', label: 'Proses Pengerjaan' },
  { id: 'spare-part', label: 'Stok Spare Part' },
];

const galleryItems = [
  {
    id: 1,
    category: 'exterior',
    title: 'Gedung Bengkel & Area Masuk',
    caption: 'Tampak depan bengkel FindFix dengan area parkir yang luas dan akses mudah di Semarang.',
    image: 'https://images.unsplash.com/photo-1619405399517-d7fce0f13302?w=1000&q=80',
  },
  {
    id: 2,
    category: 'interior',
    title: 'Area Service Bay Utama',
    caption: 'Ruang kerja bersih dengan lift hidrolik mobil dan pencahayaan optimal untuk inspeksi presisi.',
    image: 'https://images.unsplash.com/photo-1580273916550-e323be2ae537?w=1000&q=80',
  },
  {
    id: 3,
    category: 'mobil',
    title: 'Inspeksi & Tune Up Mesin Mobil',
    caption: 'Teknisi melakukan pemeriksaan menyeluruh pada ruang mesin mobil keluarga.',
    image: 'https://images.unsplash.com/photo-1625047509168-a7026f36de04?w=1000&q=80',
  },
  {
    id: 4,
    category: 'motor',
    title: 'Servis Ringan Sepeda Motor',
    caption: 'Pembersihan komponen karburator dan pengecekan sistem pengapian motor roda dua.',
    image: 'https://images.unsplash.com/photo-1558981852-426c6c22a060?w=1000&q=80',
  },
  {
    id: 5,
    category: 'proses',
    title: 'Penggantian Oli Mesin & Filter',
    caption: 'Proses pembuangan oli lama dan pemasangan filter oli baru sesuai standar torsi pengencangan.',
    image: 'https://images.unsplash.com/photo-1615906655593-ad0386982a0f?w=1000&q=80',
  },
  {
    id: 6,
    category: 'proses',
    title: 'Pemeriksaan Sistem Pengereman',
    caption: 'Pengukuran ketebalan kampas rem cakram dan pembersihan kaliper rem dari debu residu.',
    image: 'https://images.unsplash.com/photo-1562813733-b31f71025d54?w=1000&q=80',
  },
  {
    id: 7,
    category: 'motor',
    title: 'Perawatan Ruang CVT Motor Matic',
    caption: 'Pembersihan rumah roller dan v-belt motor matic untuk menghilangkan gejala gredek saat tarikan awal.',
    image: 'https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=1000&q=80',
  },
  {
    id: 8,
    category: 'interior',
    title: 'Ruang Tunggu Pelanggan',
    caption: 'Fasilitas ruang tunggu ber-AC yang nyaman dengan koneksi Wi-Fi gratis selama kendaraan dikerjakan.',
    image: 'https://images.unsplash.com/photo-1517524008697-84bbe3c3fd98?w=1000&q=80',
  },
  {
    id: 9,
    category: 'spare-part',
    title: 'Rak Pelumas & Filter Original',
    caption: 'Penyimpanan stok oli mesin dari merek-merek ternama yang terjamin keasliannya.',
    image: 'https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=1000&q=80',
  },
  {
    id: 10,
    category: 'mobil',
    title: 'Diagnosis Kelistrikan & Scan OBD',
    caption: 'Penggunaan scanner diagnostik komputer untuk membaca kode error sensor kendaraan modern.',
    image: 'https://images.unsplash.com/photo-1620288627223-53302f4e8c74?w=1000&q=80',
  },
  {
    id: 11,
    category: 'proses',
    title: 'Pengecekan Tekanan & Kondisi Ban',
    caption: 'Inspeksi kedalaman alur ban dan balancing roda untuk menjaga stabilitas kemudi di kecepatan tinggi.',
    image: 'https://images.unsplash.com/photo-1578844251758-2f71da64c96f?w=1000&q=80',
  },
  {
    id: 12,
    category: 'mobil',
    title: 'Servis & Flushing Kompresor AC',
    caption: 'Pembersihan evaporator dan pengisian ulang freon AC untuk menjaga hembusan kabin tetap sejuk.',
    image: 'https://images.unsplash.com/photo-1563720223185-11003d516935?w=1000&q=80',
  },
];
---

<Layout
  title="Galeri Workshop & Dokumentasi Pengerjaan - FindFix Semarang"
  description="Dokumentasi fasilitas bengkel, aktivitas teknisi, pengerjaan servis mobil dan motor, serta fasilitas FindFix Automotive Service Center Semarang."
>
  <!-- Hero Section -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Galeri</span>
      </nav>

      <div class="gallery-hero-header">
        <p class="section-eyebrow">Dokumentasi Bengkel</p>
        <h1>Melihat Lebih Dekat Fasilitas &amp; Pengerjaan Kami</h1>
        <p class="hero-desc">
          Transparansi adalah komitmen kami. Simak suasana bengkel, peralatan kerja, serta ketelitian teknisi FindFix dalam merawat setiap unit mobil dan motor pelanggan.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Gallery Section -->
  <section class="section gallery-main-section">
    <div class="container">
      <!-- Filter Tabs -->
      <div class="gallery-filter-tabs" role="tablist" aria-label="Kategori Galeri">
        {galleryCategories.map((cat, i) => (
          <button
            class={`gallery-filter-btn ${i === 0 ? 'active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-masonry-grid" id="gallery-grid">
        {galleryItems.map((item) => (
          <div
            class="gallery-card"
            data-category={item.category}
            data-image={item.image}
            data-title={item.title}
            data-caption={item.caption}
          >
            <div class="gallery-card-img-wrap">
              <img src={item.image} alt={item.title} class="gallery-card-img" loading="lazy" />
              <div class="gallery-card-hover-overlay">
                <span class="zoom-icon" aria-hidden="true">🔍</span>
                <span class="zoom-label">Lihat Foto</span>
              </div>
            </div>
            <div class="gallery-card-caption-box">
              <span class="card-cat-tag">
                {galleryCategories.find(c => c.id === item.category)?.label || item.category}
              </span>
              <h3 class="card-photo-title">{item.title}</h3>
              <p class="card-photo-desc">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Pratinjau Foto Galeri">
    <button class="lightbox-close-btn" id="lightbox-close" aria-label="Tutup Pratinjau">✕</button>
    <button class="lightbox-nav-btn lightbox-prev" id="lightbox-prev" aria-label="Foto Sebelumnya">‹</button>
    <button class="lightbox-nav-btn lightbox-next" id="lightbox-next" aria-label="Foto Selanjutnya">›</button>
    <div class="lightbox-container">
      <img src="" alt="Pratinjau Dokumentasi Workshop FindFix" id="lightbox-img" class="lightbox-img" />
      <div class="lightbox-meta">
        <h4 id="lightbox-title" class="lightbox-title"></h4>
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <section class="section section-dark final-cta">
    <div class="container" style="text-align: center;">
      <p class="section-eyebrow" style="color: var(--color-orange); margin: 0 auto 16px;">Kunjungi Langsung</p>
      <h2 style="max-width: 18ch; margin: 0 auto 20px;">Ingin Kendaraan Anda Ditangani dengan Standar Serupa?</h2>
      <p class="section-desc" style="margin: 0 auto 36px; color: rgba(255,255,255,0.65);">
        Percayakan perawatan kendaraan Anda pada bengkel FindFix. Dapatkan kenyamanan tempat, transparansi pengerjaan, dan jaminan hasil memuaskan.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/booking" class="btn btn-primary btn-lg">Booking Servis Sekarang</a>
        <a
          href={waLink("Halo FindFix, saya melihat galeri bengkel dan ingin tanya jadwal servis.")}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-white btn-lg"
        >
          Tanya via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
.gallery-hero-header {
  max-width: 760px;
  margin-top: 24px;
}
.gallery-hero-header h1 {
  color: white;
  margin-bottom: 16px;
}

/* Filter Tabs */
.gallery-filter-tabs {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 40px;
}
.gallery-filter-btn {
  padding: 10px 22px;
  border-radius: 999px;
  font-family: var(--font-heading);
  font-size: 0.875rem;
  font-weight: 700;
  border: 1.5px solid var(--color-border);
  background: var(--color-white);
  color: var(--color-gray);
  cursor: pointer;
  transition: all var(--transition-fast);
}
.gallery-filter-btn:hover {
  border-color: var(--color-orange);
  color: var(--color-orange);
}
.gallery-filter-btn.active {
  background: var(--color-navy);
  border-color: var(--color-navy);
  color: white;
}

/* Gallery Grid */
.gallery-masonry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.gallery-card {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  cursor: pointer;
  transition: all var(--transition-base);
  display: flex;
  flex-direction: column;
}
.gallery-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
  border-color: rgba(244, 123, 53, 0.4);
}
.gallery-card-img-wrap {
  position: relative;
  overflow: hidden;
  height: 240px;
}
.gallery-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.gallery-card:hover .gallery-card-img {
  transform: scale(1.06);
}
.gallery-card-hover-overlay {
  position: absolute;
  inset: 0;
  background: rgba(16, 27, 43, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  opacity: 0;
  transition: opacity var(--transition-fast);
}
.gallery-card:hover .gallery-card-hover-overlay {
  opacity: 1;
}
.zoom-icon {
  font-size: 1.5rem;
}
.zoom-label {
  font-family: var(--font-heading);
  font-size: 0.8125rem;
  font-weight: 700;
  color: white;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.gallery-card-caption-box {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.card-cat-tag {
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-orange);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
}
.card-photo-title {
  font-size: 1.0625rem;
  color: var(--color-navy);
  margin-bottom: 6px;
  line-height: 1.35;
}
.card-photo-desc {
  font-size: 0.8125rem;
  color: var(--color-gray);
  line-height: 1.5;
  margin: 0;
}

/* Lightbox Modal */
.lightbox-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 16, 26, 0.95);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.lightbox-overlay.active {
  opacity: 1;
  pointer-events: auto;
}
.lightbox-close-btn {
  position: absolute;
  top: 24px;
  right: 28px;
  background: rgba(255, 255, 255, 0.15);
  color: white;
  border: none;
  font-size: 1.5rem;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition-fast);
}
.lightbox-close-btn:hover {
  background: var(--color-orange);
}
.lightbox-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.15);
  color: white;
  border: none;
  font-size: 2rem;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
  z-index: 10001;
  user-select: none;
}
.lightbox-nav-btn:hover {
  background: var(--color-orange);
  transform: translateY(-50%) scale(1.05);
}
.lightbox-prev {
  left: 24px;
}
.lightbox-next {
  right: 24px;
}
@media (max-width: 640px) {
  .lightbox-nav-btn {
    width: 40px;
    height: 40px;
    font-size: 1.5rem;
  }
  .lightbox-prev { left: 8px; }
  .lightbox-next { right: 8px; }
}
.lightbox-container {
  max-width: 900px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.lightbox-img {
  max-width: 100%;
  max-height: 70vh;
  border-radius: var(--radius-md);
  object-fit: contain;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
}
.lightbox-meta {
  margin-top: 18px;
  text-align: center;
  color: white;
  max-width: 640px;
}
.lightbox-title {
  font-size: 1.25rem;
  color: white;
  margin-bottom: 6px;
}
.lightbox-caption {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

@media (max-width: 1024px) {
  .gallery-masonry-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .gallery-masonry-grid {
    grid-template-columns: 1fr;
  }
  .gallery-filter-tabs {
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
  }
}
</style>

<script>
  // Filter Functionality
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const cards = document.querySelectorAll('.gallery-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.dataset.category;
        if (filter === 'all' || cat === filter) {
          el.style.display = 'flex';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // Lightbox Functionality with Next/Prev and Keyboard navigation
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentCardIndex = -1;

  function getVisibleCards(): HTMLElement[] {
    return Array.from(cards).filter((c) => (c as HTMLElement).style.display !== 'none') as HTMLElement[];
  }

  function showLightboxIndex(index: number) {
    const visibleCards = getVisibleCards();
    if (visibleCards.length === 0) return;

    if (index < 0) index = visibleCards.length - 1;
    if (index >= visibleCards.length) index = 0;
    currentCardIndex = index;

    const el = visibleCards[currentCardIndex];
    const img = el.dataset.image || '';
    const title = el.dataset.title || '';
    const caption = el.dataset.caption || '';

    if (lightboxImg) {
      lightboxImg.src = img;
      lightboxImg.alt = title;
    }
    if (lightboxTitle) lightboxTitle.textContent = title;
    if (lightboxCaption) lightboxCaption.textContent = caption;

    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const visibleCards = getVisibleCards();
      const idx = visibleCards.indexOf(card as HTMLElement);
      showLightboxIndex(idx >= 0 ? idx : 0);
    });
  });

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightboxIndex(currentCardIndex - 1);
  });
  lightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightboxIndex(currentCardIndex + 1);
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      showLightboxIndex(currentCardIndex - 1);
    } else if (e.key === 'ArrowRight') {
      showLightboxIndex(currentCardIndex + 1);
    }
  });
</script>
