---
import { SITE, waLink } from '../config/site';

const navLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang Kami', href: '/tentang-kami' },
  { label: 'Layanan', href: '/layanan' },
  { label: 'Harga', href: '/harga' },
  { label: 'Spare Part', href: '/spare-part' },
  { label: 'Artikel', href: '/artikel' },
  { label: 'Kontak', href: '/kontak' },
];

const currentPath = Astro.url.pathname;
---

<header id="navbar" class="navbar">
  <div class="container navbar-inner">
    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label="FindFix - Halaman Utama">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="36" height="36" rx="8" fill="#F47B35"/>
        <path d="M8 14h20M8 18h14M8 22h18" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="26" cy="22" r="3" stroke="white" stroke-width="2"/>
        <path d="M24.5 20.5L27.5 23.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span class="navbar-logo-text">
        <span class="logo-find">Find</span><span class="logo-fix">Fix</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="navbar-nav" aria-label="Navigasi Utama">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="navbar-actions">
      <a href="/booking" class="btn btn-primary btn-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Booking Servis
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        class="mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <nav aria-label="Navigasi Mobile">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`mobile-nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="mobile-menu-cta">
        <a href="/booking" class="btn btn-primary" style="width: 100%; justify-content: center;">
          Booking Servis Sekarang
        </a>
        <a href={waLink("Halo FindFix! Saya ingin menghubungi tim FindFix.")} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="width: 100%; justify-content: center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
    padding: 20px 0;
  }
  .navbar.scrolled,
  .navbar.menu-open {
    background: var(--color-navy);
    box-shadow: 0 2px 20px rgba(0,0,0,0.25);
    padding: 12px 0;
  }
  .navbar.nav-transparent { background: transparent; }
  .navbar.nav-solid { background: var(--color-navy); }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* Logo */
  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .navbar-logo-text {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: white;
  }
  .logo-find { color: white; }
  .logo-fix { color: var(--color-orange); }

  /* Desktop Nav */
  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .nav-link:hover { color: white; background: rgba(255,255,255,0.08); }
  .nav-link.active { color: var(--color-orange); }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Hamburger */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .mobile-menu-btn:hover { background: rgba(255,255,255,0.08); }
  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s ease;
    background: var(--color-navy);
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .mobile-menu.open { max-height: 600px; }
  .mobile-menu-inner {
    padding: 20px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-menu-inner nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    padding: 13px 24px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    margin: 0 16px;
  }
  .mobile-nav-link:hover { color: white; background: rgba(255,255,255,0.06); }
  .mobile-nav-link.active { color: var(--color-orange); }
  .mobile-menu-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 24px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-top: 16px;
  }
  .mobile-menu-cta .btn-secondary {
    color: white;
    border-color: rgba(255,255,255,0.3);
  }
  .mobile-menu-cta .btn-secondary:hover {
    background: rgba(255,255,255,0.08);
    color: white;
  }

  @media (max-width: 1024px) {
    .navbar-nav { display: none; }
    .mobile-menu-btn { display: flex; }
    .mobile-menu { display: block; }
    .navbar-actions .btn:not(.mobile-menu-btn) { display: none; }
  }
  @media (min-width: 1025px) {
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Scroll state
  function updateNavbar() {
    if (!navbar) return;
    if (window.scrollY > 60) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  function setMenuState(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('aria-hidden', String(!open));
    menu?.classList.toggle('open', open);
    navbar?.classList.toggle('menu-open', open);
  }

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    setMenuState(!expanded);
  });

  // Close menu on outside click
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('open') && !navbar?.contains(e.target as Node)) {
      setMenuState(false);
    }
  });

  // Close menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      setMenuState(false);
    }
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });
</script>
