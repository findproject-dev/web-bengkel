---
import Layout from '../../layouts/Layout.astro';
import { SERVICES, getServicesByCategory } from '../../data/services';
import { waLink } from '../../config/site';

const carServices = getServicesByCategory('mobil');
const motorServices = getServicesByCategory('motor');
const generalServices = getServicesByCategory('umum');
---

<Layout
  title="Layanan Bengkel Mobil & Motor Semarang - FindFix"
  description="Layanan lengkap bengkel FindFix Semarang: servis berkala, perbaikan mesin, ganti oli, servis AC, rem & kaki-kaki, kelistrikan, servis motor, spooring & balancing, dan lebih banyak lagi."
>

<!-- Page Hero -->
<section class="page-hero layanan-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Layanan</span>
    </nav>
    <div class="layanan-hero-content">
      <div>
        <p class="section-eyebrow">Layanan Kami</p>
        <h1>Layanan Lengkap untuk Kendaraan Anda</h1>
        <p class="hero-desc">
          FindFix menyediakan layanan perawatan dan perbaikan lengkap untuk mobil dan motor dengan harga kompetitif, pengerjaan profesional, dan garansi layanan.
        </p>
        <div class="hero-actions" style="margin-top:28px;">
          <a href="/booking" class="btn btn-primary btn-lg">Booking Servis</a>
          <a href="/harga" class="btn btn-outline-white btn-lg">Lihat Harga</a>
        </div>
      </div>
      <div class="hero-stats">
        <div class="hero-stat-box">
          <span class="stat-num">12+</span>
          <span class="stat-label">Jenis Layanan Mobil</span>
        </div>
        <div class="hero-stat-box">
          <span class="stat-num">9+</span>
          <span class="stat-label">Jenis Layanan Motor</span>
        </div>
        <div class="hero-stat-box">
          <span class="stat-num">2017</span>
          <span class="stat-label">Melayani Sejak</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Filter Navigation -->
<div class="layanan-filter-bar">
  <div class="container">
    <div class="filter-tabs" role="tablist" aria-label="Filter layanan">
      <button class="filter-tab active" data-filter="semua" role="tab" aria-selected="true">Semua Layanan</button>
      <button class="filter-tab" data-filter="mobil" role="tab" aria-selected="false">Layanan Mobil</button>
      <button class="filter-tab" data-filter="motor" role="tab" aria-selected="false">Layanan Motor</button>
      <button class="filter-tab" data-filter="umum" role="tab" aria-selected="false">Layanan Umum</button>
    </div>
  </div>
</div>

<!-- Car Services -->
<section class="section layanan-section" id="mobil-section" data-section="mobil">
  <div class="container">
    <div class="layanan-section-header" data-animate>
      <div class="section-label">
        <span class="section-label-icon" aria-hidden="true">🚗</span>
        <h2>Layanan Mobil</h2>
      </div>
      <p class="section-desc">Perawatan dan perbaikan lengkap untuk kendaraan roda empat Anda.</p>
    </div>
    <div class="layanan-grid">
      {carServices.map((svc, i) => (
        <article class="layanan-card" data-animate data-delay={String((i % 4) * 100)} data-category="mobil">
          <div class="layanan-card-img-wrap">
            <img src={svc.image} alt={svc.name} loading="lazy" class="layanan-card-img" />
            <span class="layanan-category-badge">Mobil</span>
            {svc.featured && <span class="layanan-featured-badge">Populer</span>}
          </div>
          <div class="layanan-card-body">
            <h3 class="layanan-card-title">{svc.name}</h3>
            <p class="layanan-card-desc">{svc.shortDesc}</p>
            <div class="layanan-card-benefits">
              {svc.benefits.slice(0, 3).map(b => (
                <div class="layanan-benefit">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-orange)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{b}</span>
                </div>
              ))}
            </div>
            <div class="layanan-card-footer">
              <div class="layanan-price-info">
                <span class="layanan-price">{svc.startingPrice}</span>
                <span class="layanan-duration">⏱ {svc.duration}</span>
              </div>
              <div class="layanan-card-actions">
                <a href={`/layanan/${svc.slug}`} class="btn btn-secondary btn-sm">Detail</a>
                <a href={`/booking?layanan=${encodeURIComponent(svc.name)}`} class="btn btn-primary btn-sm">Booking</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Motor Services -->
<section class="section layanan-section section-offwhite" id="motor-section" data-section="motor">
  <div class="container">
    <div class="layanan-section-header" data-animate>
      <div class="section-label">
        <span class="section-label-icon" aria-hidden="true">🏍️</span>
        <h2>Layanan Motor</h2>
      </div>
      <p class="section-desc">Perawatan dan perbaikan terlengkap untuk motor kesayangan Anda.</p>
    </div>
    <div class="layanan-grid">
      {motorServices.map((svc, i) => (
        <article class="layanan-card" data-animate data-delay={String((i % 4) * 100)} data-category="motor">
          <div class="layanan-card-img-wrap">
            <img src={svc.image} alt={svc.name} loading="lazy" class="layanan-card-img" />
            <span class="layanan-category-badge motor-badge">Motor</span>
            {svc.featured && <span class="layanan-featured-badge">Populer</span>}
          </div>
          <div class="layanan-card-body">
            <h3 class="layanan-card-title">{svc.name}</h3>
            <p class="layanan-card-desc">{svc.shortDesc}</p>
            <div class="layanan-card-benefits">
              {svc.benefits.slice(0, 3).map(b => (
                <div class="layanan-benefit">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-orange)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{b}</span>
                </div>
              ))}
            </div>
            <div class="layanan-card-footer">
              <div class="layanan-price-info">
                <span class="layanan-price">{svc.startingPrice}</span>
                <span class="layanan-duration">⏱ {svc.duration}</span>
              </div>
              <div class="layanan-card-actions">
                <a href={`/layanan/${svc.slug}`} class="btn btn-secondary btn-sm">Detail</a>
                <a href={`/booking?layanan=${encodeURIComponent(svc.name)}`} class="btn btn-primary btn-sm">Booking</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- General Services -->
<section class="section layanan-section" id="umum-section" data-section="umum">
  <div class="container">
    <div class="layanan-section-header" data-animate>
      <div class="section-label">
        <span class="section-label-icon" aria-hidden="true">🔍</span>
        <h2>Layanan Tambahan</h2>
      </div>
      <p class="section-desc">Layanan pemeriksaan dan bantuan darurat untuk ketenangan berkendara.</p>
    </div>
    <div class="layanan-grid layanan-grid-2col">
      {generalServices.map((svc, i) => (
        <article class="layanan-card layanan-card-horizontal" data-animate data-delay={String(i * 150)} data-category="umum">
          <div class="layanan-card-img-wrap layanan-card-img-sm">
            <img src={svc.image} alt={svc.name} loading="lazy" class="layanan-card-img" />
          </div>
          <div class="layanan-card-body">
            <h3 class="layanan-card-title">{svc.name}</h3>
            <p class="layanan-card-desc">{svc.shortDesc}</p>
            <p class="layanan-desc-long">{svc.description}</p>
            <div class="layanan-card-footer">
              <span class="layanan-price">{svc.startingPrice}</span>
              <div class="layanan-card-actions">
                <a href={`/layanan/${svc.slug}`} class="btn btn-secondary btn-sm">Detail</a>
                <a href={`/booking?layanan=${encodeURIComponent(svc.name)}`} class="btn btn-primary btn-sm">Booking</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="section section-dark layanan-cta">
  <div class="container" style="text-align:center;">
    <p class="section-eyebrow" style="color:var(--color-orange);margin:0 auto 16px;">Butuh Bantuan?</p>
    <h2 style="max-width:18ch;margin:0 auto 20px;">Tidak Yakin Layanan Apa yang Dibutuhkan?</h2>
    <p class="section-desc" style="margin:0 auto 36px;color:rgba(255,255,255,0.6);">
      Konsultasikan keluhan kendaraan Anda kepada tim FindFix. Kami siap membantu menentukan solusi terbaik.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href={waLink("Halo FindFix! Saya ingin konsultasi mengenai kendaraan saya. Bisa dibantu?")} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Konsultasi via WhatsApp
      </a>
      <a href="/booking" class="btn btn-outline-white btn-lg">Booking Langsung</a>
    </div>
  </div>
</section>

</Layout>

<style>
.layanan-hero {
  background: var(--color-navy);
  padding: 120px 0 72px;
}
.layanan-hero h1 { color: white; margin-bottom: 16px; }
.layanan-hero .hero-desc { color: rgba(255,255,255,0.65); margin-bottom: 0; }
.layanan-hero-content {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 48px;
  align-items: center;
  margin-top: 32px;
}
.hero-stats {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hero-stat-box {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  padding: 20px 28px;
  text-align: center;
  min-width: 160px;
}
.stat-num {
  display: block;
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 800;
  color: var(--color-orange);
  line-height: 1;
  margin-bottom: 6px;
}
.stat-label { font-size: 0.8125rem; color: rgba(255,255,255,0.5); }

.layanan-filter-bar {
  background: var(--color-white);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 72px;
  z-index: 100;
  padding: 16px 0;
}

.layanan-section-header { margin-bottom: 40px; }
.section-label { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.section-label h2 { margin: 0; font-size: 1.75rem; }
.section-label-icon { font-size: 1.5rem; }
.section-offwhite { background: var(--color-off-white); }

.layanan-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.layanan-grid-2col { grid-template-columns: repeat(2, 1fr); }

.layanan-card {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-base);
}
.layanan-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }

.layanan-card-horizontal { flex-direction: row; }
.layanan-card-horizontal .layanan-card-body { flex: 1; }

.layanan-card-img-wrap { position: relative; flex-shrink: 0; }
.layanan-card-img { width: 100%; height: 200px; object-fit: cover; }
.layanan-card-img-sm .layanan-card-img { width: 220px; height: 100%; min-height: 220px; }
.layanan-category-badge {
  position: absolute; top: 10px; left: 10px;
  background: rgba(16,27,43,0.75); backdrop-filter: blur(4px);
  color: white; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em;
  padding: 3px 10px; border-radius: 999px;
}
.motor-badge { background: rgba(244,123,53,0.8); }
.layanan-featured-badge {
  position: absolute; top: 10px; right: 10px;
  background: var(--color-orange);
  color: white; font-size: 0.6875rem; font-weight: 700;
  padding: 3px 10px; border-radius: 999px;
}

.layanan-card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
.layanan-card-title { font-size: 1rem; font-weight: 700; color: var(--color-navy); margin-bottom: 8px; }
.layanan-card-desc { font-size: 0.8125rem; color: var(--color-gray); line-height: 1.6; margin-bottom: 16px; }
.layanan-desc-long { font-size: 0.875rem; color: var(--color-gray); line-height: 1.65; margin-bottom: 16px; }

.layanan-card-benefits { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; flex: 1; }
.layanan-benefit { display: flex; align-items: flex-start; gap: 8px; font-size: 0.8125rem; color: var(--color-navy); }

.layanan-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--color-border); margin-top: auto; }
.layanan-price-info { display: flex; flex-direction: column; gap: 2px; }
.layanan-price { font-family: var(--font-heading); font-size: 0.9375rem; font-weight: 700; color: var(--color-orange); }
.layanan-duration { font-size: 0.75rem; color: var(--color-gray); }
.layanan-card-actions { display: flex; gap: 8px; }

@media (max-width: 1024px) {
  .layanan-grid { grid-template-columns: repeat(3, 1fr); }
  .layanan-grid-2col { grid-template-columns: 1fr; }
  .layanan-hero-content { grid-template-columns: 1fr; }
  .hero-stats { flex-direction: row; justify-content: flex-start; }
}
@media (max-width: 768px) {
  .layanan-grid { grid-template-columns: repeat(2, 1fr); }
  .layanan-card-horizontal { flex-direction: column; }
  .layanan-card-img-sm .layanan-card-img { width: 100%; height: 200px; min-height: auto; }
  .hero-stats { flex-wrap: wrap; }
}
@media (max-width: 480px) {
  .layanan-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-direction: column; }
}
</style>

<script>
  // Filter functionality
  const filterTabs = document.querySelectorAll('.filter-tab');
  const layananCards = document.querySelectorAll('.layanan-card');
  const sections = document.querySelectorAll('.layanan-section');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = (tab as HTMLElement).dataset.filter;

      filterTabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      sections.forEach(section => {
        const sectionFilter = (section as HTMLElement).dataset.section;
        if (filter === 'semua' || filter === sectionFilter) {
          (section as HTMLElement).style.display = 'block';
        } else {
          (section as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
