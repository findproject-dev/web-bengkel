---
import Layout from '../layouts/Layout.astro';
import { SITE, waLink } from '../config/site';
import { getFeaturedServices, SERVICES } from '../data/services';
import { ARTICLES, ARTICLE_CATEGORIES } from '../data/articles';
import { PROMOS } from '../data/promos';

const featuredServices = getFeaturedServices().slice(0, 6);
const latestArticles = ARTICLES.slice(0, 3);
const featuredPromos = PROMOS.filter(p => p.featured).slice(0, 3);

const trustStats = [
  { label: "Melayani Sejak", value: "2017", icon: "🏆" },
  { label: "Layanan", value: "Mobil & Motor", icon: "🚗" },
  { label: "Harga", value: "Kompetitif", icon: "💰" },
  { label: "Garansi", value: "Layanan", icon: "✅" },
];

const whyUs = [
  {
    icon: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z",
    title: "Harga Lebih Bersahabat",
    desc: "Harga kompetitif dan transparan. Estimasi biaya disampaikan sebelum perbaikan dimulai.",
  },
  {
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Pengerjaan Profesional",
    desc: "Tim teknisi berpengalaman yang mengutamakan standar kualitas dalam setiap pengerjaan.",
  },
  {
    icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
    title: "Garansi Layanan",
    desc: "Layanan perbaikan disertai garansi sesuai ketentuan yang berlaku.",
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Proses Lebih Efisien",
    desc: "Proses pelayanan terorganisir untuk meminimalkan waktu tunggu kendaraan.",
  },
  {
    icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
    title: "Pemeriksaan Transparan",
    desc: "Setiap kondisi kendaraan dijelaskan secara jelas. Perbaikan hanya dilakukan atas persetujuan.",
  },
  {
    icon: "M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0",
    title: "Mobil dan Motor",
    desc: "Layanan lengkap untuk kendaraan roda empat maupun roda dua dalam satu bengkel.",
  },
];

const steps = [
  { num: "01", title: "Pilih Layanan", desc: "Tentukan jenis layanan yang dibutuhkan atau konsultasikan keluhan kendaraan Anda." },
  { num: "02", title: "Buat Booking", desc: "Isi informasi kendaraan dan pilih jadwal kunjungan yang sesuai." },
  { num: "03", title: "Pemeriksaan", desc: "Teknisi memeriksa kondisi kendaraan dan menyampaikan estimasi biaya kepada Anda." },
  { num: "04", title: "Pengerjaan & Garansi", desc: "Perbaikan dilakukan setelah mendapat persetujuan. Garansi diberikan sesuai ketentuan." },
];

const faqs = [
  { q: "Apakah FindFix melayani mobil dan motor?", a: "Ya, FindFix melayani perawatan dan perbaikan untuk kendaraan roda empat (mobil) maupun roda dua (motor) dalam satu bengkel." },
  { q: "Apakah harus booking sebelum datang?", a: "Booking sebelumnya sangat dianjurkan untuk memastikan ketersediaan teknisi dan meminimalkan waktu tunggu. Namun, pelanggan walk-in juga dilayani sesuai kapasitas." },
  { q: "Bagaimana cara mengetahui estimasi biaya servis?", a: "Estimasi biaya akan disampaikan setelah pemeriksaan awal kendaraan. Perbaikan hanya dilakukan setelah mendapat persetujuan pelanggan." },
  { q: "Apakah tersedia garansi pengerjaan?", a: "Ya, layanan perbaikan FindFix disertai garansi sesuai ketentuan yang berlaku. Detail garansi diinformasikan saat proses servis." },
  { q: "Apakah FindFix menjual spare part?", a: "Ya, FindFix menyediakan berbagai suku cadang kendaraan. Hubungi kami untuk ketersediaan dan harga spare part yang Anda butuhkan." },
  { q: "Apakah tersedia layanan darurat?", a: "FindFix dapat dihubungi melalui WhatsApp untuk konsultasi darurat dan panduan penanganan awal. Hubungi kami untuk informasi lebih lanjut." },
  { q: "Berapa lama waktu pengerjaan servis?", a: "Waktu pengerjaan bervariasi tergantung jenis layanan. Servis ringan umumnya 30–90 menit, sementara perbaikan kompleks bisa memerlukan waktu lebih lama. Estimasi waktu akan disampaikan sebelum pengerjaan." },
  { q: "Bagaimana cara melakukan booking?", a: "Booking dapat dilakukan melalui halaman Booking di website ini, atau langsung melalui WhatsApp. Setelah mengisi form, tim FindFix akan mengkonfirmasi jadwal Anda." },
];

const galleryImages = [
  { src: "https://images.unsplash.com/photo-1625047509168-a7026f36de04?w=600&q=80", alt: "Mekanik memeriksa mesin mobil di bengkel FindFix" },
  { src: "https://images.unsplash.com/photo-1558981852-426c6c22a060?w=600&q=80", alt: "Perawatan motor di bengkel FindFix" },
  { src: "https://images.unsplash.com/photo-1487754180451-c456f719a1fc?w=600&q=80", alt: "Pemeriksaan kendaraan oleh teknisi FindFix" },
  { src: "https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?w=600&q=80", alt: "Proses tune up mesin mobil" },
  { src: "https://images.unsplash.com/photo-1562813733-b31f71025d54?w=600&q=80", alt: "Pemeriksaan sistem rem kendaraan" },
  { src: "https://images.unsplash.com/photo-1620288627223-53302f4e8c74?w=600&q=80", alt: "Pemeriksaan sistem kelistrikan kendaraan" },
];

const testimonials = [
  { name: "Budi S.", vehicle: "Honda Jazz 2019", rating: 5, text: "Pelayanan ramah, harga sesuai estimasi, dan pengerjaan cepat. Sudah beberapa kali servis di sini dan selalu puas." },
  { name: "Dian R.", vehicle: "Yamaha NMAX", rating: 5, text: "Motor matic saya bermasalah di CVT. Teknisi menjelaskan masalahnya dengan detail sebelum perbaikan. Recommended!" },
  { name: "Eko P.", vehicle: "Toyota Avanza 2018", rating: 5, text: "Ganti oli sekaligus servis berkala. Harga kompetitif, pelayanan profesional. Pasti balik lagi ke FindFix." },
];
---

<Layout
  title="FindFix - Bengkel Mobil & Motor Semarang"
  description="FindFix bengkel umum mobil dan motor di Semarang. Perawatan, perbaikan, dan servis kendaraan dengan harga kompetitif, pengerjaan profesional, dan pelayanan terpercaya sejak 2017."
>

<!-- ═══ HERO ════════════════════════════════════════════════ -->
<section class="hero" aria-label="Hero FindFix">
  <div class="hero-bg">
    <img
      src="https://images.unsplash.com/photo-1619405399517-d7fce0f13302?w=1600&q=85"
      alt="Bengkel FindFix - Workshop otomotif profesional"
      class="hero-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-text">
      <p class="hero-eyebrow" data-animate data-delay="0">
        BENGKEL MOBIL &amp; MOTOR • SEMARANG
      </p>
      <h1 class="hero-title" data-animate data-delay="100">
        Perawatan Tepat.<br/>
        <span class="hero-title-accent">Perjalanan</span><br/>
        Lebih Aman.
      </h1>
      <p class="hero-desc" data-animate data-delay="200">
        Solusi perawatan dan perbaikan mobil maupun motor dengan harga bersahabat, pengerjaan profesional, dan pelayanan terpercaya.
      </p>
      <div class="hero-actions" data-animate data-delay="300">
        <a href="/booking" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Booking Servis
        </a>
        <a href="/layanan" class="btn btn-outline-white btn-lg">
          Jelajahi Layanan
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
      <div class="hero-trust" data-animate data-delay="400">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="trust-icon" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Melayani sejak 2017
        </div>
        <div class="trust-sep" aria-hidden="true">•</div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Harga kompetitif
        </div>
        <div class="trust-sep" aria-hidden="true">•</div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Garansi layanan
        </div>
      </div>
    </div>

    <!-- Hero Stats Card -->
    <div class="hero-card" data-animate data-delay="300">
      <div class="hero-card-inner">
        <div class="hero-card-header">
          <span class="hero-card-badge">FindFix Semarang</span>
        </div>
        <div class="hero-card-stats">
          <div class="hero-stat">
            <span class="hero-stat-num">2017</span>
            <span class="hero-stat-label">Berdiri Sejak</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">2 in 1</span>
            <span class="hero-stat-label">Mobil & Motor</span>
          </div>
        </div>
        <div class="hero-card-services">
          <div class="hero-service-tag">🔧 Servis Berkala</div>
          <div class="hero-service-tag">🛠️ Perbaikan Mesin</div>
          <div class="hero-service-tag">🔋 Kelistrikan</div>
          <div class="hero-service-tag">❄️ Servis AC</div>
          <div class="hero-service-tag">⚙️ Transmisi</div>
          <div class="hero-service-tag">🏍️ Servis Motor</div>
        </div>
        <a href="/booking" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:4px;">
          Booking Sekarang →
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="scroll-dot"></div>
  </div>
</section>

<!-- ═══ TRUST STATS BAR ══════════════════════════════════════ -->
<section class="trust-bar" aria-label="Keunggulan FindFix">
  <div class="container trust-bar-grid">
    {trustStats.map((stat, i) => (
      <div class="trust-bar-item" data-animate data-delay={String(i * 100)}>
        <span class="trust-bar-icon" aria-hidden="true">{stat.icon}</span>
        <div>
          <div class="trust-bar-value">{stat.value}</div>
          <div class="trust-bar-label">{stat.label}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ═══ ABOUT PREVIEW ═══════════════════════════════════════ -->
<section class="section about-preview">
  <div class="container about-preview-grid">
    <div class="about-preview-img" data-animate>
      <img
        src="https://images.unsplash.com/photo-1537041373723-1c7ea30b4e44?w=800&q=80"
        alt="Interior bengkel FindFix yang modern dan profesional"
        loading="lazy"
        class="about-img"
      />
      <div class="about-badge">
        <span class="about-badge-num">2017</span>
        <span class="about-badge-text">Melayani<br/>Sejak</span>
      </div>
    </div>
    <div class="about-preview-text" data-animate data-delay="200">
      <p class="section-eyebrow">Tentang FindFix</p>
      <h2 class="section-title">Lebih dari Sekadar Bengkel.</h2>
      <p class="about-desc">
        FindFix merupakan bengkel umum mobil dan motor yang telah melayani pelanggan sejak 2017 di Semarang. Kami mengutamakan harga kompetitif, kualitas pengerjaan, serta pelayanan yang cepat dan terpercaya.
      </p>
      <p class="about-desc" style="margin-top:16px;">
        Setiap kendaraan yang masuk ke FindFix mendapatkan perhatian penuh dari teknisi berpengalaman kami. Kami percaya bahwa transparansi dan komunikasi yang baik adalah fondasi kepercayaan pelanggan.
      </p>
      <div class="about-values">
        <div class="about-value">
          <div class="about-value-dot"></div>
          <span>Harga transparan</span>
        </div>
        <div class="about-value">
          <div class="about-value-dot"></div>
          <span>Perbaikan atas persetujuan pelanggan</span>
        </div>
        <div class="about-value">
          <div class="about-value-dot"></div>
          <span>Garansi pengerjaan</span>
        </div>
        <div class="about-value">
          <div class="about-value-dot"></div>
          <span>Layanan mobil dan motor</span>
        </div>
      </div>
      <a href="/tentang-kami" class="btn btn-ghost">
        Pelajari Lebih Lanjut
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══ SERVICES OVERVIEW ════════════════════════════════════ -->
<section class="section section-dark services-section" aria-label="Layanan FindFix">
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-eyebrow" style="color:var(--color-orange)">Layanan Kami</p>
      <h2 class="section-title">Solusi Lengkap untuk<br/>Kendaraan Anda.</h2>
      <p class="section-desc">Layanan perawatan dan perbaikan lengkap untuk mobil dan motor — dari servis rutin hingga perbaikan kompleks.</p>
    </div>

    <div class="services-grid">
      {[
        { name: "Servis Berkala", icon: "⚙️", href: "/layanan/servis-berkala-mobil", desc: "Perawatan rutin sesuai jadwal pabrikan" },
        { name: "Perbaikan Mesin", icon: "🔧", href: "/layanan/perbaikan-mesin-mobil", desc: "Diagnosis dan perbaikan masalah mesin" },
        { name: "Ganti Oli", icon: "🛢️", href: "/layanan/ganti-oli-mobil", desc: "Oli berkualitas untuk mesin yang terlindungi" },
        { name: "Servis AC", icon: "❄️", href: "/layanan/servis-ac-mobil", desc: "Perawatan AC untuk kabin yang nyaman" },
        { name: "Rem & Kaki-kaki", icon: "🛞", href: "/layanan/perbaikan-rem-mobil", desc: "Sistem pengereman dan suspensi optimal" },
        { name: "Kelistrikan", icon: "⚡", href: "/layanan/kelistrikan-mobil", desc: "Diagnosis dan perbaikan sistem listrik" },
        { name: "Transmisi", icon: "⛓️", href: "/layanan/servis-transmisi-mobil", desc: "Perawatan sistem transmisi manual & matic" },
        { name: "Servis Motor", icon: "🏍️", href: "/layanan/servis-ringan-motor", desc: "Layanan lengkap untuk motor kesayangan" },
        { name: "Spooring & Balancing", icon: "🎯", href: "/layanan/spooring-balancing", desc: "Penyetelan roda untuk berkendara nyaman" },
        { name: "Body Repair", icon: "🚗", href: "/layanan/body-repair-pengecatan", desc: "Perbaikan bodi dan pengecatan kendaraan" },
      ].map((svc, i) => (
        <a href={svc.href} class="svc-card" data-animate data-delay={String((i % 5) * 100)}>
          <span class="svc-icon" aria-hidden="true">{svc.icon}</span>
          <h3 class="svc-name">{svc.name}</h3>
          <p class="svc-desc">{svc.desc}</p>
          <span class="svc-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="section-cta" data-animate>
      <a href="/layanan" class="btn btn-outline-white btn-lg">
        Lihat Semua Layanan
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══ WHY FINDFIX ══════════════════════════════════════════ -->
<section class="section why-section" aria-label="Mengapa memilih FindFix">
  <div class="container">
    <div class="why-header" data-animate>
      <p class="section-eyebrow">Keunggulan Kami</p>
      <h2 class="section-title">Kenapa Memilih<br/>FindFix?</h2>
    </div>
    <div class="why-grid">
      {whyUs.map((item, i) => (
        <div class="why-card" data-animate data-delay={String((i % 3) * 150)}>
          <div class="why-icon-wrap" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={item.icon}/>
            </svg>
          </div>
          <h3 class="why-title">{item.title}</h3>
          <p class="why-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FEATURED SERVICES ════════════════════════════════════ -->
<section class="section section-slate featured-section" aria-label="Layanan unggulan">
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-eyebrow" style="color:var(--color-orange)">Layanan Unggulan</p>
      <h2 class="section-title">Layanan yang Paling<br/>Sering Dibutuhkan.</h2>
    </div>
    <div class="featured-grid">
      {featuredServices.map((svc, i) => (
        <div class="featured-card" data-animate data-delay={String((i % 3) * 100)}>
          <div class="featured-img-wrap">
            <img
              src={svc.image}
              alt={svc.name}
              loading="lazy"
              class="featured-img"
            />
            <span class="featured-category-badge">{svc.category === 'mobil' ? 'Mobil' : svc.category === 'motor' ? 'Motor' : 'Umum'}</span>
          </div>
          <div class="featured-body">
            <h3 class="featured-title">{svc.name}</h3>
            <p class="featured-desc">{svc.shortDesc}</p>
            <div class="featured-meta">
              <span class="featured-price">{svc.startingPrice}</span>
              <a href={`/layanan/${svc.slug}`} class="btn btn-ghost" style="padding:0;font-size:0.875rem;">
                Detail
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ SERVICE PROCESS ══════════════════════════════════════ -->
<section class="section process-section" aria-label="Proses servis FindFix">
  <div class="container">
    <div class="process-header" data-animate>
      <p class="section-eyebrow">Cara Kerja</p>
      <h2 class="section-title">Servis Lebih Mudah,<br/>Tanpa Ribet.</h2>
      <p class="section-desc">Proses yang terstruktur untuk pengalaman servis yang nyaman dan transparan.</p>
    </div>
    <div class="process-steps">
      {steps.map((step, i) => (
        <div class="process-step" data-animate data-delay={String(i * 150)}>
          <div class="step-num-wrap">
            <span class="step-num">{step.num}</span>
            {i < steps.length - 1 && <div class="step-line" aria-hidden="true"></div>}
          </div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="process-cta" data-animate>
      <a href="/booking" class="btn btn-primary btn-lg">
        Mulai Booking Sekarang
      </a>
    </div>
  </div>
</section>

<!-- ═══ PRICING PREVIEW ══════════════════════════════════════ -->
<section class="section section-dark pricing-preview" aria-label="Harga layanan FindFix">
  <div class="container">
    <div class="section-header" data-animate>
      <p class="section-eyebrow" style="color:var(--color-orange)">Harga</p>
      <h2 class="section-title">Perawatan Berkualitas,<br/>Harga Bersahabat.</h2>
      <p class="section-desc" style="color:rgba(255,255,255,0.5);">
